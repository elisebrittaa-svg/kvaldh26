<!DOCTYPE html>
<html> <head> <title>Kaart</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.5.1/leaflet.js"></script> <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.5.1/leaflet.css" /> <style> body { padding: 0; margin: 0; } html, body { height: 100%; width: 100%; } #selgitus { width: 100%; height: 10%; box-sizing: border-box; padding: 10px; font-size: 16px; } #kaardikiht { width: 100%; height: 90%; } </style> <script> let kaart; let hypik; let marker1; let marker2; let grupp; function algus(){ kaart = L.map('kaardikiht').setView([59.439, 24.773], 12); new L.TileLayer( 'https://tiles.maaamet.ee/tm/tms/1.0.0/hybriid@GMC/{z}/{x}/{y}.png&ASUTUS=TLU&ERIALA=DIGIHUMANITAARIA', { attribution: "Map: <a href='http://www.maaamet.ee/'>Maa-amet</a>", tms: true } ).addTo(kaart); // Kaks punkti, mida saab kaardil valida marker1 = L.marker([59.439, 24.773]); marker2 = L.marker([59.439, 24.773]); // Alguses ei näita neid kaardil marker1.addTo(kaart); marker2.addTo(kaart); // Grupp sisaldab mõõtmise punkte ja teekonda grupp = L.layerGroup(); grupp.addTo(kaart); hypik = L.popup(); // Kaardile vajutamine kaart.on("click", vajutus); // Google Sheetsis olevate Jaapani kohtade kuvamine kuvaJaapaniKohad(); } // ========================================================= // GOOGLE SHEETSI ANDMETE KUVAMINE // ========================================================= function kuvaJaapaniKohad(){ fetch( "https://script.google.com/macros/s/AKfycbx337Akc5D9Mgxduqi6LjnBqQ1bkMYt_V5gVvdTq_W1u1-PFXKVMXurrYsbwBKMRGhimw/exec" ) .then(d => d.json()) .then(andmed => { console.log("Google Sheetsist saadud andmed:"); console.log(andmed); for(let koht of andmed){ let marker = L.marker([ Number(koht.laiuskraad), Number(koht.pikkuskraad) ]); marker.bindPopup( "<b>" + koht.kommentaar + "</b><br>" + koht.tyyp + "<br><br>" + "Koordinaadid:<br>" + Number(koht.laiuskraad).toFixed(6) + ", " + Number(koht.pikkuskraad).toFixed(6) ); marker.addTo(kaart); } }) .catch(viga => { console.log("Google Sheetsi lugemisel tekkis viga:"); console.log(viga); }); } // ========================================================= // KAARDILE VAJUTAMINE // ========================================================= function vajutus(e){ hypik.setLatLng(e.latlng) .setContent( "Vajutasid:<br>" + "Laiuskraad: " + e.latlng.lat.toFixed(6) + "<br>" + "Pikkuskraad: " + e.latlng.lng.toFixed(6) ) .openOn(kaart); // Esimene vajutus if(marker1._valitud != true){ marker1.setLatLng(e.latlng); marker1._valitud = true; document.getElementById("selgitus").innerText = "Esimene punkt valitud. Vajuta nüüd teisele kohale."; return; } // Teine vajutus if(marker2._valitud != true){ marker2.setLatLng(e.latlng); marker2._valitud = true; liikumine(); return; } // Kolmas vajutus alustab uut mõõtmist grupp.clearLayers(); marker1.setLatLng(e.latlng); marker1._valitud = true; marker2._valitud = false; document.getElementById("selgitus").innerText = "Uus alguspunkt valitud. Vajuta nüüd teisele kohale."; } // ========================================================= // TEEKONNA ARVUTAMINE // ========================================================= function liikumine(){ document.getElementById("selgitus").innerText = "Arvutan rattateekonda..."; grupp.clearLayers(); let koht1 = marker1.getLatLng(); let koht2 = marker2.getLatLng(); // Sirgjooneline kaugus let linnulennult = koht1.distanceTo(koht2) / 1000; // OSRM rattateekonna aadress let aadress = "https://router.project-osrm.org/route/v1/cycling/" + koht1.lng + "," + koht1.lat + ";" + koht2.lng + "," + koht2.lat + "?overview=full&geometries=geojson"; console.log(aadress); fetch(aadress) .then(d => d.json()) .then(kuvaTee) .catch(viga => { console.log("Teekonna arvutamisel tekkis viga:"); console.log(viga); document.getElementById("selgitus").innerText = "Teekonna arvutamine ebaõnnestus."; }); } // ========================================================= // TEEKONNA KUVAMINE // ========================================================= function kuvaTee(andmed){ console.log(andmed); if(!andmed.routes || andmed.routes.length == 0){ document.getElementById("selgitus").innerText = "Nende punktide vahel rattateekonda ei leitud."; return; } let tee = andmed.routes[0]; console.log("Aeg sekundites:"); console.log(tee["duration"]); console.log("Kaugus meetrites:"); console.log(tee["distance"]); console.log("Teekonna geomeetria:"); console.log(tee["geometry"]); // Kaugus kilomeetrites let kaugus = Math.round(tee.distance) / 1000; // Aeg minutites let aeg = Math.round(tee.duration / 60); // Kuvame tulemuse document.getElementById("selgitus").innerText = "Rattaga: " + kaugus.toFixed(1) + " km | umbes " + aeg + " min"; // Kuvame alguspunkti marker1.bindPopup( "Alguspunkt" ); // Kuvame lõpp-punkti marker2.bindPopup( "Sihtpunkt" ); // Joonistame rattateekonna L.geoJSON( tee.geometry, { style: { color: "red", weight: 5 } } ).addTo(grupp); } </script> </head> <body onload="algus()"> <div id="selgitus">
 Vajuta kaardil kohta, kust soovid alustada.

</div> <div id="kaardikiht"></div> </body> </html>
